{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "es2019",
      "dom"
    ],
    "jsx": "react-native",
    "module": "es2015",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js"
  ],
  "exclude": [
    "node_modules"
  ],
  "extends": "expo/tsconfig.base"
}
