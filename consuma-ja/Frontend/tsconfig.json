{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "lib": ["es2019", "dom"],
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowJs": true
  },
  "extends": "expo/tsconfig.base",
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js"],
  "exclude": ["node_modules"]
}
