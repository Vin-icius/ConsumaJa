{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // --- OPÇÕES NECESSÁRIAS PARA DECORATORS ---
    "experimentalDecorators": true,   // <<< HABILITAR/ADICIONAR
    "emitDecoratorMetadata": true,    // <<< HABILITAR/ADICIONAR
    // ------------------------------------------

    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}